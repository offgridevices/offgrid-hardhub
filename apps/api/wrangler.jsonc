// HardHub API. Local dev (`pnpm dev`) uses the top level: local D1, R2 and
// Durable Objects, and the engine container from docker compose at ENGINE_URL.
// `env.production` is the Cloudflare deployment: every resource in the US
// jurisdiction, and the engine as a Cloudflare Container.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hardhub-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "vars": {
    "DEV": "1",
    "APP_URL": "http://localhost:5173",
    "WEB_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
    "ENGINE_URL": "http://localhost:8080",
    "US_ONLY": "0"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "hardhub", "database_id": "local-hardhub", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "hardhub-files" }],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "ProjectRoom" },
      { "name": "ENGINE", "class_name": "EngineContainer" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectRoom", "EngineContainer"] }],
  "observability": { "enabled": true },

  "env": {
    "production": {
      // Every part of HardHub on Cloudflare is named offgrid-hardhub*: this
      // Worker, its database, its file bucket and its engine container (the
      // Durable Objects live inside the Worker). README: "Remove it all".
      "name": "offgrid-hardhub",
      // OffGrid's address: Cloudflare adds the DNS record and certificate for
      // this one hostname on deploy and touches nothing else in the zone. The
      // zone must be on the same Cloudflare account; a fork puts its own here.
      // No workers.dev address, so sign-in and MCP have one address only.
      "routes": [{ "pattern": "hardhub.offgridevices.com", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      // Secret (made by ./hardhub deploy): KEY_ENCRYPTION_KEY. Sign-in is email
      // and password: no email service, and only the first account (the
      // owner's) can be made.
      "vars": {
        "DEV": "0",
        // empty: the Worker's own address (the custom domain above)
        "APP_URL": "",
        // the web app is served by this same Worker: no other origin needs CORS
        "WEB_ORIGINS": "",
        "ENGINE_URL": "",
        "US_ONLY": "1"
      },
      // The web app (apps/web/dist, built with VITE_API_URL=/api) is served by
      // this Worker; /api/* goes to the API, and so do /mcp and the agent
      // sign-in paths (/oauth/*, /.well-known/*); every other path to the app.
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/mcp", "/oauth/*", "/.well-known/*"]
      },
      // ./hardhub deploy creates both in the US jurisdiction and writes the id here
      "d1_databases": [{ "binding": "DB", "database_name": "offgrid-hardhub-db", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "offgrid-hardhub-files", "jurisdiction": "us" }],
      "durable_objects": {
        "bindings": [
          { "name": "ROOMS", "class_name": "ProjectRoom" },
          { "name": "ENGINE", "class_name": "EngineContainer" }
        ]
      },
      "containers": [
        {
          "name": "offgrid-hardhub-engine",
          "class_name": "EngineContainer",
          "image": "../../engine/Dockerfile",
          "instance_type": "standard-3",
          "max_instances": 4,
          // US-only placement (ENAM/WNAM)
          "constraints": { "jurisdiction": "us" }
        }
      ]
    }
  }
}
