#!/usr/bin/env bash
# HardHub on your own computer. Needs only Docker (Docker Desktop on a Mac).
#
#   ./hardhub            start everything and open the app
#   ./hardhub stop       stop it (your projects are kept)
#   ./hardhub logs       follow the logs
#   ./hardhub test       run the end-to-end test (scripted AI, real engine)
#   ./hardhub reset      stop and delete local data (projects, keys)
#   ./hardhub ollama     download the small local AI model (needs Ollama installed)
#   ./hardhub deploy     put HardHub on Cloudflare (needs Node.js 22+ and Docker)
set -euo pipefail
cd "$(dirname "$0")"
. scripts/compose.sh

URL=http://localhost:5173
STATE=.hardhub              # local state: the Claude Code bridge's token, pid and log
say() { printf '\033[1m%s\033[0m\n' "$*"; }

# HardHub's chat can run on your own Claude Code (your Claude subscription):
# a small helper on this computer, bridge/bridge.mjs, runs the official
# `claude` program for each turn. Started only when Claude Code and Node.js
# are here; HardHub works without it.
start_bridge() {
  stop_bridge
  command -v claude >/dev/null 2>&1 || return 0
  # local HardHub signs anyone in without email: opened to the network, the
  # bridge would let others on it use your Claude subscription
  if [ "${HARDHUB_BIND:-127.0.0.1}" != 127.0.0.1 ]; then
    say "HardHub is open to your network (HARDHUB_BIND), so HardHub's chat won't use your Claude Code. Your Claude app can still connect over MCP."
    return 0
  fi
  if ! command -v node >/dev/null 2>&1 || [ "$(node -p 'process.versions.node.split(".")[0]')" -lt 20 ]; then
    say "Claude Code found. To use it in HardHub's chat, install Node.js 20 or newer (https://nodejs.org) and run ./hardhub again."
    return 0
  fi
  mkdir -p "$STATE" && chmod 700 "$STATE"
  if [ ! -s "$STATE/bridge-token" ]; then
    (umask 077 && od -An -tx1 -N32 /dev/urandom | tr -d ' \n' > "$STATE/bridge-token")
  fi
  local host=127.0.0.1
  # Docker on Linux reaches the host through its bridge network, not loopback
  [ "$(uname -s)" = Linux ] && host=0.0.0.0
  mkdir -p "$STATE/claude" && chmod 700 "$STATE/claude"
  BRIDGE_TOKEN="$(cat "$STATE/bridge-token")" BRIDGE_HOST="$host" BRIDGE_PORT=8789 BRIDGE_HOME="$PWD/$STATE/claude" \
    nohup node bridge/bridge.mjs >"$STATE/bridge.log" 2>&1 &
  echo $! > "$STATE/bridge.pid"
  sleep 1
  if ! kill -0 "$(cat "$STATE/bridge.pid")" 2>/dev/null; then
    say "Claude Code found, but its helper did not start: $(tail -n 1 "$STATE/bridge.log")"
    rm -f "$STATE/bridge.pid"
    return 0
  fi
  export HARDHUB_BRIDGE_URL=http://host.docker.internal:8789
  HARDHUB_BRIDGE_TOKEN="$(cat "$STATE/bridge-token")"
  export HARDHUB_BRIDGE_TOKEN
  say "Claude Code found: HardHub's chat can use your Claude subscription (Settings → Claude Code on this computer)."
}

stop_bridge() {
  if [ -f "$STATE/bridge.pid" ]; then
    local pid
    pid="$(cat "$STATE/bridge.pid")"
    # only if that process is still our bridge (after a restart the number may be another program's)
    if ps -p "$pid" -o command= 2>/dev/null | grep -q 'bridge/bridge.mjs'; then
      kill "$pid" 2>/dev/null || true
      for _ in 1 2 3 4 5 6; do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    fi
    rm -f "$STATE/bridge.pid"
  fi
}

need_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    say "Docker is not installed. Install Docker Desktop: https://www.docker.com/products/docker-desktop/"
    exit 1
  fi
  if ! docker info >/dev/null 2>&1; then
    if [ "$(uname)" = Darwin ]; then
      # whichever Docker this Mac uses: Colima when it is the current context
      # (or the only one installed), else Docker Desktop
      if ! command -v colima >/dev/null 2>&1 || { [ -d /Applications/Docker.app ] && [ "$(docker context show 2>/dev/null)" != colima ]; }; then
        say "Starting Docker Desktop…"
        open -a Docker || true
      else
        say "Starting Colima…"
        colima start || true
      fi
      for _ in $(seq 1 90); do docker info >/dev/null 2>&1 && break; sleep 2; done
    fi
    docker info >/dev/null 2>&1 || { say "Docker is not running. Start Docker Desktop (or Colima) and try again."; exit 1; }
  fi
}

wait_up() {
  printf 'Waiting for HardHub to start'
  for _ in $(seq 1 300); do
    if curl -fs "$URL" >/dev/null 2>&1 && curl -fs http://localhost:8787/health >/dev/null 2>&1; then
      echo; return 0
    fi
    printf '.'; sleep 2
  done
  echo; say "HardHub did not start in 10 minutes. See: ./hardhub logs"; exit 1
}

case "${1:-start}" in
  start|up)
    need_docker
    start_bridge
    say "Building and starting HardHub (the first run downloads KiCad, about 1 GB; later runs take seconds)…"
    compose up --build --detach --wait --wait-timeout 900 || { compose ps || true; say "Something failed to start. See: ./hardhub logs (if a port is busy, close the app using 5173, 8787 or 8080)"; exit 1; }
    wait_up
    say "HardHub is running at $URL"
    if [ "$(uname)" = Darwin ]; then open "$URL"; elif command -v xdg-open >/dev/null; then xdg-open "$URL" >/dev/null 2>&1 || true; fi
    ;;
  stop|down) stop_bridge; compose down ;;
  logs) compose logs --follow --tail 200 ;;
  test) need_docker; exec ./e2e/run.sh ;;
  ollama)
    # optional: a small local model, so HardHub runs with no API key at all
    command -v ollama >/dev/null || { say "Install Ollama first: https://ollama.com/download"; exit 1; }
    ollama pull "${OLLAMA_MODEL:-qwen3.5:0.8b}"
    say "Done. In HardHub: Settings → AI provider → Ollama on this computer."
    ;;
  reset) stop_bridge; compose down --volumes ;;
  deploy)
    need_docker
    command -v node >/dev/null || { say "Install Node.js 22 or newer: https://nodejs.org"; exit 1; }
    [ "$(node -p 'process.versions.node.split(".")[0]')" -ge 22 ] || { say "Node.js 22 or newer is needed (you have $(node -v))."; exit 1; }
    # pnpm at the version package.json pins, with nothing installed globally:
    # through corepack where Node ships it (up to 24), else through npx
    pm=$(node -p 'require("./package.json").packageManager')
    if command -v corepack >/dev/null; then pnpm() { corepack pnpm "$@"; }; else pnpm() { npx --yes "$pm" "$@"; }; fi
    pnpm install --frozen-lockfile
    pnpm --filter @hardhub/api run deploy
    ;;
  *) sed -n '2,11p' "$0"; exit 2 ;;
esac
